# ── Supabase (Project Settings → API) ─────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # SERVER ONLY. Never expose to the browser.

# ── Twilio (Console → Account Info) ───────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM_NUMBER=+13055550100          # your Twilio number in E.164

# ── Resend (resend.com → API Keys) ────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Azul Reviews <reviews@yourdomain.com>"   # domain must be verified in Resend

# ── Vapi lead alerts (POST /api/vapi-webhook) ────────────────────────
VAPI_WEBHOOK_SECRET=change-me-random          # same value as the Server URL secret in Vapi
VAPI_LEAD_TO=owner@helloyou.com, you@azul.com   # who gets the email after each call
# VAPI_LEAD_ROUTES={"<assistantId>":"owner@spa.com"}   # optional per-assistant routing (multi-client)
# VAPI_LEAD_BUSINESS=Hello You Wellness Center       # optional display name in the email
# VAPI_LEAD_TRANSCRIPT=false                          # optional: leave transcript out of the email

# ── App ───────────────────────────────────────────────────────────
APP_URL=http://localhost:3000            # public base URL (used to build review links)
ADMIN_KEY=change-me-long-random-string   # protects /admin + admin API routes
CRON_SECRET=change-me-another-random     # protects /api/send-due

# Individual account sign-in. Only the public/anon key is allowed in VITE_*.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Turn on only AFTER named accounts have been provisioned and tested.
DISABLE_LEGACY_ACCESS_KEYS=false

# Estimate Follow-Up agent. Drafting/sending are disabled by default.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
# USD per million tokens for the selected model. Confirm against its official pricing.
# These rates estimate usage and conservatively reserve budget before every attempt.
AGENT_INPUT_USD_PER_MILLION=
AGENT_OUTPUT_USD_PER_MILLION=
AGENT_EMAIL_FROM="Azul Follow-ups <followups@your-verified-domain.com>"
AGENTS_ENABLED=false
AGENTS_EMAIL_ENABLED=false
