# Public HTTPS endpoint: POST { name, email, consent, guide, language }
# Return { "downloadUrl": "https://.../guide.pdf" } after recording consent.
VITE_GUIDE_ENDPOINT=
# Public HTTPS endpoint: POST { email, consent, language }; return 2xx on success.
VITE_NEWSLETTER_ENDPOINT=
# Optional replacement for the default purpose film.
VITE_PURPOSE_VIDEO=

# ── Free report (/free-report → api/free-report/). Server-only: set these in the
# Vercel project settings, never with a VITE_ prefix. See docs/FREE-REPORT-SETUP.md.
GOOGLE_API_KEY=
# Any long random string: openssl rand -base64 32
FREE_REPORT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: email the team when a lead unlocks a report (Resend).
RESEND_API_KEY=
EMAIL_FROM=
FREE_REPORT_NOTIFY_EMAIL=
